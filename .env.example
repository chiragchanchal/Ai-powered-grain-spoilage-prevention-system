# AgroGuard AI - Environment Configuration

# Server Settings
HOST=0.0.0.0
PORT=8000

# Storage Facility Metadata
FACILITY_ID=FAC_GURUGRAM_01
FACILITY_NAME="Gurugram Central Agro-Mandi Godown"
DEFAULT_REGION="Haryana"
DEFAULT_LAT=28.4595
DEFAULT_LON=77.0266

# OpenWeatherMap API Key (Optional: Leave empty to use intelligent meteorological simulation)
OPENWEATHER_API_KEY=""

# Apache Cassandra Cluster (Optional: Defaults to local time-series SQLite persistence matching Cassandra CQL)
CASSANDRA_HOSTS="localhost"
CASSANDRA_KEYSPACE="grain_guard"

# Neo4j Graph Database (Optional: Defaults to embedded high-performance NetworkX domain graph)
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="password"
